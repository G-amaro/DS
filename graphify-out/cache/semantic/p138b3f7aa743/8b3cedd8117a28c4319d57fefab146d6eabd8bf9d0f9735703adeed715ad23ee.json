{"nodes": [{"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_document", "label": "Plataforma de partilha privada de incidentes: estado das decis\u00f5es", "file_type": "document", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_plataforma_partilha_incidentes", "label": "Privacy-preserving incident sharing platform", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_federacao_operadores", "label": "Federation of network operators", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_federation_coordinator", "label": "Federation Coordinator", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enrolls members, issues credentials, revokes, distributes new group keys; sees who is a member but not who wrote what."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_federation_arbiter", "label": "Federation Arbiter", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only entity able to reveal a reporter in a dispute; kept separate from Coordinator and CA so collusion has a barrier."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_tsa", "label": "Timestamp Authority (TSA)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent from CA and members so the timestamp's value comes from independence from the reporter; sees only the report hash."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_ca_privada", "label": "Private federation CA", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offline module/CLI built with `cryptography` (ca.py); generates self-signed root, signs service CSRs; root is trust anchor. Chosen instead of Google CAs (cost, billing account, cannot issue for localhost/Docker or TSA certs, external root of trust)."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_apache_kafka", "label": "Apache Kafka", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Suggested by professor; persistent log with offsets allows offline members to recover history, total order within a partition. Broker treated as honest-but-curious and sees only ciphertext."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_camada_anonimato", "label": "Network anonymity layer", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hides publisher source IP; options Tor or own relay with batching and random delays."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_membro_cliente", "label": "Member (client)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_biblioteca_cryptography", "label": "Python `cryptography` library", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers keys, X.509, signatures, authenticated encryption, KDF; but no RFC 3161 tokens, group/ring signatures or anonymous credentials."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_google_cas", "label": "Google CA Service / Certificate Manager Public CA (rejected alternative)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_formato_relatorio_json", "label": "Report JSON format (report_id, incident_type, indicators, observation_period, severity, recommended_mitigation)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_reporte_anonimo", "label": "Anonymous reporting", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_corroboracao_anonima", "label": "Anonymous corroboration", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At most once per member per report, never own report; public count serves as trust indicator."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_disputa", "label": "Dispute / reporter de-anonymization", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_inscricao_revogacao", "label": "Enrollment and revocation", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_modelo_ameaca", "label": "Threat model (honest-but-curious servers, malicious members)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_honest_but_curious", "label": "Honest-but-curious servers", "file_type": "rationale", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_unlinkability", "label": "Unlinkability", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flexible level (none, per report, per period, total); first open decision because it constrains almost everything else."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_confidencialidade_chave_grupo", "label": "Confidentiality via per-epoch symmetric group key with rekeying on revocation", "file_type": "rationale", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alternatives: per-member encryption, broadcast encryption."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_autenticacao_anonima", "label": "Anonymous authentication mechanism", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Candidates: group signatures, blind signatures, anonymous credentials, rotating pseudonyms; must be built on `cryptography`."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_integridade_aes_gcm", "label": "Integrity via signature + AES-GCM authenticated encryption", "file_type": "rationale", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_timestamping", "label": "Trusted timestamping (RFC 3161 full or simplified)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`cryptography` lacks RFC 3161; options are `openssl ts` or simplified TSA signing hash+time, declared as simplification."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_accountability", "label": "Accountability (Arbiter identity opening)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_anti_dupla_corroboracao", "label": "Anti double-corroboration tag dependent on report_id", "file_type": "rationale", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_metadados_rede", "label": "Network metadata (source IP) protection", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_topico_reports", "label": "Kafka topic `reports`", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_topico_corroborations", "label": "Kafka topic `corroborations`", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_topico_control", "label": "Kafka topic `control`", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_certificados_servidor", "label": "Server TLS certificates", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_certificado_tsa", "label": "TSA certificate (timeStamping EKU)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_credencial_membro", "label": "Member credential (anonymous credential / group key)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_separacao_papeis", "label": "Separation of roles (Arbiter/Coordinator/CA/TSA)", "file_type": "rationale", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If one entity could enroll, revoke and de-anonymize, collusion would have no barrier."}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_regra_de_ouro", "label": "Golden rule: justify each requirement choice and compare with an alternative", "file_type": "rationale", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_estrutura_relatorio_final", "label": "Final report structure (10 pages)", "file_type": "concept", "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_document", "target": "docs_plataforma_de_partilha_privada_de_incidentes_estado_das_decis\u00f5es_plataforma_partilha_incidentes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Plataforma de partilha privada de incidentes estado das deciso\u0303es.md", "source_location": null, "weight": 1.0}, {"source"