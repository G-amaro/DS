blications"}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_directory_version_v", "label": "Vers\u00e3o V (diret\u00f3rio de membros + K_adm)", "file_type": "concept", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_mtls_x509_auth", "label": "Autentica\u00e7\u00e3o por certificado X.509 (CSR) com TLS m\u00fatuo", "file_type": "concept", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_crl_revocation", "label": "Revoga\u00e7\u00e3o por CRL assinada pela CA (RFC 5280)", "file_type": "rationale", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over OCSP/short-lived certs; CRL installed on broker and Arbiter, never published to members"}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_domain_separation", "label": "Separa\u00e7\u00e3o de dom\u00ednio e prefixos de comprimento nas assinaturas", "file_type": "rationale", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A signature of one type cannot be reused in another type or epoch"}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_message_formats", "label": "Formatos assinados FED-REPORT/CORROB/CRED/POP/DIR/VERDICT-v1", "file_type": "concept", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pl