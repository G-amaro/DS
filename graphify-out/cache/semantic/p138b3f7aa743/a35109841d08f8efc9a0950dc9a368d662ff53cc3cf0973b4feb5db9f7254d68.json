{"nodes": [{"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2", "label": "Plano de implementa\u00e7\u00e3o em Python (19 nov 2026)", "file_type": "document", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_epoch_pseudonyms", "label": "Pseud\u00f3nimos por \u00e9poca (12h, pk_E/sk_E)", "file_type": "rationale", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlinkability between epochs; alternative to linkable ring/group signatures and anonymous credentials"}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_credential_batch", "label": "Lote de credenciais (at\u00e9 6 \u00e9pocas)", "file_type": "rationale", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Member requests a batch once a day at staggered hours to reduce timing correlation; renewal ~2 epochs before end with random delay"}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_content_key_k_c", "label": "Chave de conte\u00fado K_c por mensagem (AES-256-GCM)", "file_type": "rationale", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fresh random key per message; alternative ChaCha20-Poly1305"}, {"id": "docs_plano_de_implementa\u00e7\u00e3o_em_python_2_ecies", "label": "ECIES (X25519 ef\u00e9mero, HKDF-SHA256, AES-GCM)", "file_type": "rationale", "source_file": "docs/Plano de implementac\u0327a\u0303o em Python-2.pdf", "source_location": null, "source_url": null, "captured_at": nu